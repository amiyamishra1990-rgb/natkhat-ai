# Natkhat AI — apps/admin environment template
#
# M25 (docs/sprints/sprint-05.md, §4; Founder Decision G.2; ADR-0016).
# Same real, non-production dev Firebase project (`natkhat-ai-dev`) as
# apps/backend's FIREBASE_PROJECT_ID (apps/backend/.env.example) — test/
# synthetic admin accounts only, no production project or credential.
# These NEXT_PUBLIC_* values are Firebase's own public client config
# (safe to ship in a browser bundle by Firebase's own design — see
# apps/backend/.env.example's FIREBASE_WEB_API_KEY comment for the same
# point made about the backend), left unset here rather than hardcoded
# so this app is never coupled to one specific Firebase project. The
# /sign-in page fails clearly (not silently) if these are missing (see
# lib/firebase-client.ts).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID="natkhat-ai-dev"
# Optional — defaults to "<NEXT_PUBLIC_FIREBASE_PROJECT_ID>.firebaseapp.com"
# (Firebase's own convention) when unset.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""

# M22 (docs/sprints/sprint-04.md, §4) — unchanged from that milestone.
# Where apps/admin's server components (app/audit/page.tsx) reach
# apps/backend. Defaults to http://localhost:3000 if unset.
BACKEND_API_URL="http://localhost:3000"
