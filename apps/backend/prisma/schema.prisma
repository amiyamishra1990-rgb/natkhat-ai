// M14 — Identity, Family & Tenant-Isolation Implementation
// (docs/sprints/sprint-03.md, §4; ADR-0008; ADR-0010;
// docs/modules/identity-family/README.md, §3).
//
// Six entities, fields, and relationships exactly per the module
// document's field tables. Row-Level Security policies (ADR-0010, §7)
// are not expressible in Prisma schema language and are applied via
// raw SQL in this schema's migration (see prisma/migrations/).
//
// Fields whose allowed value set is not enumerated by the approved
// documents (Device.deviceType, Device.status, Session.endReason,
// CoParentAssignment.permissionScope — module doc, §3.5/§3.6, gives
// only illustrative examples, not a closed set) are modeled as plain
// String, not a Prisma enum, to avoid inventing a bounded set the
// governing documents do not themselves fix.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Parent.status, Family.status — module doc, §3.2/§3.3: active | suspended | deleted.
enum ParentStatus {
  active
  suspended
  deleted
}

enum FamilyStatus {
  active
  suspended
  deleted
}

// Child.status — module doc, §3.4: active | deleted (no "suspended" listed for Child).
enum ChildStatus {
  active
  deleted
}

// CoParentAssignment.status — module doc, §3.5: active | revoked.
enum CoParentAssignmentStatus {
  active
  revoked
}

// Session.principal_type — module doc, §3.6: Parent | Child (Child reserved, not activated).
enum SessionPrincipalType {
  Parent
  Child
}

model Parent {
  id              String       @id @default(uuid()) @db.Uuid
  // M15 (docs/sprints/sprint-03.md, §4; ADR-0016) adds the unique
  // constraint the Firebase Auth lookup (auth/firebase-auth.service.ts)
  // depends on — a verified external identity must resolve to exactly
  // one Parent, never an ambiguous match. The column itself is
  // unchanged from M14 (docs/modules/identity-family/README.md, §3.2);
  // this is the minimal additive constraint M15's own scope ("wire
  // Firebase Auth") requires, not a redesign of the Parent entity.
  authIdentityRef String       @unique @map("auth_identity_ref")
  displayName     String       @map("display_name")
  contactEmail    String       @map("contact_email")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  status          ParentStatus @default(active)
  // M16 (docs/sprints/sprint-03.md, §4; ADR-0015 §4/§6) — the
  // deleted_at/status-transition timestamp ADR-0015 §4 explicitly
  // flagged as missing from every M1 entity ("a real, necessary
  // addition for a future ADR-0004 implementation"). deletedAt is set
  // when status transitions to `deleted` (soft-delete); hardDeletedAt
  // is set separately when the 90-day window (ADR-0015 §13.1) elapses
  // and the row is tombstoned (§6) — content fields scrubbed, id and
  // status retained so FK-referencing rows (Family.owningParentId,
  // Child.createdByParentId, CoParentAssignment actor fields,
  // AuditEvent.actorPrincipalId) keep resolving. Two separate nullable
  // columns, not a third status-enum value, so the existing
  // ParentStatus enum (and every place that already reads it) is
  // unchanged.
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz
  hardDeletedAt   DateTime?    @map("hard_deleted_at") @db.Timestamptz

  ownedFamilies              Family[]             @relation("FamilyOwningParent")
  createdChildren            Child[]              @relation("ChildCreatedByParent")
  coParentGrants             CoParentAssignment[] @relation("CoParentAssignmentParent")
  invitedCoParentAssignments CoParentAssignment[] @relation("CoParentAssignmentInvitedBy")
  revokedCoParentAssignments CoParentAssignment[] @relation("CoParentAssignmentRevokedBy")
  devices                    Device[]
  auditEvents                AuditEvent[]
  consentEvents              ConsentEvent[]
  vaultedLeoMemories         LeoMemory[]

  @@map("parent")
}

model Family {
  id             String       @id @default(uuid()) @db.Uuid
  owningParentId String       @map("owning_parent_id") @db.Uuid
  displayName    String       @map("display_name")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  status         FamilyStatus @default(active)
  // M16 — see Parent.deletedAt/hardDeletedAt's comment; same mechanism.
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  hardDeletedAt  DateTime?    @map("hard_deleted_at") @db.Timestamptz

  owningParent        Parent               @relation("FamilyOwningParent", fields: [owningParentId], references: [id])
  children            Child[]
  coParentAssignments CoParentAssignment[]
  sessions            Session[]
  auditEvents         AuditEvent[]
  consentEvents       ConsentEvent[]
  encryptionKey       FamilyEncryptionKey?
  conversations       Conversation[]
  messages            Message[]
  leoMemories         LeoMemory[]

  @@index([owningParentId])
  @@map("family")
}

model Child {
  id                String      @id @default(uuid()) @db.Uuid
  familyId          String      @map("family_id") @db.Uuid
  firstName         String      @map("first_name")
  dateOfBirth       DateTime    @map("date_of_birth") @db.Date
  avatarRef         String?     @map("avatar_ref")
  createdByParentId String      @map("created_by_parent_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  status            ChildStatus @default(active)
  // M16 — see Parent.deletedAt/hardDeletedAt's comment; same mechanism.
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz
  hardDeletedAt     DateTime?   @map("hard_deleted_at") @db.Timestamptz

  family          Family         @relation(fields: [familyId], references: [id])
  createdByParent Parent         @relation("ChildCreatedByParent", fields: [createdByParentId], references: [id])
  auditEvents     AuditEvent[]
  consentEvents   ConsentEvent[]
  conversations   Conversation[]
  messages        Message[]
  leoMemories     LeoMemory[]

  @@index([familyId])
  @@map("child")
}

model CoParentAssignment {
  id                String                   @id @default(uuid()) @db.Uuid
  familyId          String                   @map("family_id") @db.Uuid
  parentId          String                   @map("parent_id") @db.Uuid
  invitedByParentId String                   @map("invited_by_parent_id") @db.Uuid
  // Bounded enum set per module doc §3.5 (e.g. view_child_profile,
  // manage_child_profile) — the doc gives illustrative examples only,
  // not a closed list. Left as String; the concrete bounded set is
  // M15's enforcement-design concern (module doc §3.5: "Milestone 2
  // designs the actual enforcement check; this field only defines the
  // shape").
  permissionScope   String                   @map("permission_scope")
  status            CoParentAssignmentStatus @default(active)
  revokedAt         DateTime?                @map("revoked_at") @db.Timestamptz
  revokedByParentId String?                  @map("revoked_by_parent_id") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  family          Family  @relation(fields: [familyId], references: [id])
  parent          Parent  @relation("CoParentAssignmentParent", fields: [parentId], references: [id])
  invitedByParent Parent  @relation("CoParentAssignmentInvitedBy", fields: [invitedByParentId], references: [id])
  revokedByParent Parent? @relation("CoParentAssignmentRevokedBy", fields: [revokedByParentId], references: [id])

  @@index([familyId])
  @@index([parentId])
  @@map("co_parent_assignment")
}

model Device {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String   @map("parent_id") @db.Uuid
  deviceLabel String   @map("device_label")
  // deviceType, status: module doc §3.6 names these fields but gives no
  // enumerated value set — left as String, not a Prisma enum.
  deviceType  String   @map("device_type")
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  status      String

  parent   Parent    @relation(fields: [parentId], references: [id])
  sessions Session[]

  @@index([parentId])
  @@map("device")
}

model Session {
  id            String               @id @default(uuid()) @db.Uuid
  // principal_id is polymorphic (Parent | Child per principalType,
  // module doc §3.6) — Prisma has no native polymorphic relation, and
  // Child-principal sessions are explicitly reserved/not activated
  // (module doc §3.4). Modeled as a plain column, not a Prisma
  // relation, rather than inventing a two-column discriminated-FK
  // workaround the source documents do not specify.
  principalId   String               @map("principal_id") @db.Uuid
  principalType SessionPrincipalType @map("principal_type")
  familyId      String               @map("family_id") @db.Uuid
  deviceId      String               @map("device_id") @db.Uuid
  startedAt     DateTime             @default(now()) @map("started_at") @db.Timestamptz
  lastActiveAt  DateTime             @default(now()) @map("last_active_at") @db.Timestamptz
  endedAt       DateTime?            @map("ended_at") @db.Timestamptz
  // endReason: module doc §3.6 names the field, no enumerated value set given.
  endReason     String?              @map("end_reason")

  family Family @relation(fields: [familyId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])

  @@index([principalId])
  @@index([familyId])
  @@map("session")
}

// M16 — Data Lifecycle & Auditability Implementation
// (docs/sprints/sprint-03.md, §4; docs/architecture/audit-logging.md
// §3-§4). Tier 5 (System/Operational, ADR-0006 §7) — append-only,
// never parent-deletable (ADR-0006 §22; data-lifecycle.md §11).
//
// event_type is a closed enum per audit-logging.md §3 ("no free-text
// event descriptions — every value traces to §4"). Every one of the
// 14 cataloged types is modeled even though only a subset is emitted
// by any code that exists in this repository today — child_deleted,
// family_deleted, account_deleted, deletion_completed,
// data_export_requested, family_switch, coparent_revoked (this
// milestone's real, wired events). The remaining values
// (conversation_message_accessed, leo_memory_viewed/corrected/
// vaulted/deleted, conversation_deleted, share_link_created/revoked/
// accessed, coparent_invited) have no backing entity or orchestrating
// service yet (Conversation/LeoMemory/ShareLink land in M17+/M18; no
// "invite a co-parent" service exists yet, only the repository — see
// audit/audit.service.ts and lifecycle/lifecycle.service.ts for which
// events are actually emitted). Modeling the full closed set now,
// rather than a partial enum extended later, avoids a breaking enum
// migration once those entities exist.
enum AuditEventType {
  conversation_message_accessed
  leo_memory_viewed
  leo_memory_corrected
  leo_memory_vaulted
  leo_memory_deleted
  conversation_deleted
  data_export_requested
  child_deleted
  family_deleted
  account_deleted
  deletion_completed
  coparent_invited
  coparent_revoked
  family_switch
  share_link_created
  share_link_revoked
  share_link_accessed
}

// audit-logging.md §3's actor_role_at_time — a snapshot of the M15
// authorization.types.ts `Role` type at write time, not a live
// reference to current role (roles can change after the fact, e.g. a
// co-parent is later revoked).
enum AuditActorRole {
  owner
  co_parent
  child
}

// audit-logging.md §3's target_type — which kind of record the action
// concerned. ShareLink/Conversation/Message/LeoMemory are prospective
// (no such entity exists in this schema yet — audit-logging.md §7
// itself flags ShareLink as not modeled by M1-M6); included for the
// same closed-set-now reason as AuditEventType above.
enum AuditTargetType {
  Conversation
  Message
  LeoMemory
  Child
  Family
  Parent
  CoParentAssignment
  ShareLink
  Export
}

model AuditEvent {
  id                 String                @id @default(uuid()) @db.Uuid
  occurredAt         DateTime              @default(now()) @map("occurred_at") @db.Timestamptz
  eventType          AuditEventType        @map("event_type")
  // actor_principal_type reuses SessionPrincipalType (Parent/Child) —
  // audit-logging.md §3 says this "mirrors M1 §3.1/M2 §3's existing
  // principal typing... not a new type introduced here"; Session
  // already defined the concrete enum for that same concept, so this
  // reuses it rather than declaring a second, parallel enum.
  actorPrincipalId   String?               @map("actor_principal_id") @db.Uuid
  actorPrincipalType SessionPrincipalType? @map("actor_principal_type")
  actorRoleAtTime    AuditActorRole?       @map("actor_role_at_time")
  familyId           String?               @map("family_id") @db.Uuid
  childId            String?               @map("child_id") @db.Uuid
  targetType         AuditTargetType       @map("target_type")
  // target_id is deliberately a plain, unconstrained column, not a
  // foreign key — audit-logging.md §3 calls it an "opaque identifier"
  // precisely because it can reference any of several tables depending
  // on target_type, the same polymorphic-reference problem
  // Session.principalId already solved the same way (see that field's
  // comment above) — no per-type FK, no discriminated-FK workaround.
  targetId           String?               @map("target_id") @db.Uuid
  // metadata: content-free structured detail only (audit-logging.md
  // §3, §10 — "never contains Tier 3 content, message text, memory
  // text, or any child-identifying free text"). Enforced by convention
  // at the call site (audit/audit.service.ts), not by a database
  // constraint — Postgres cannot validate "this JSON contains no PII."
  metadata           Json?

  actorPrincipal Parent? @relation(fields: [actorPrincipalId], references: [id])
  family         Family? @relation(fields: [familyId], references: [id])
  child          Child?  @relation(fields: [childId], references: [id])

  @@index([familyId])
  @@index([actorPrincipalId])
  @@index([occurredAt])
  @@map("audit_event")
}

// M17 — Consent & Privacy Gate (docs/sprints/sprint-03.md, §4;
// ADR-0011; docs/architecture/consent-architecture.md §3-§7). Track A
// scaffold only — see consent/consent.config.ts for the off-by-default
// flag gating every write path below (Sprint 03's own rule that
// legally-gated functionality must never be enabled by default).
enum ConsentType {
  child_account_creation
  ai_companion_interaction
  privacy_terms_update
}

enum ConsentAction {
  granted
  withdrawn
  renewed
}

model ConsentEvent {
  id                    String        @id @default(uuid()) @db.Uuid
  // family_id is the RLS partition key (consent-architecture.md
  // §6.2 — "no new isolation model is introduced"), same pattern as
  // Child/CoParentAssignment.
  familyId              String        @map("family_id") @db.Uuid
  // Nullable per §3: "the very first consent event for a not-yet-
  // created Child cannot reference a Child.id that doesn't exist yet"
  // — in this milestone's atomic co-creation path (consent.service.ts)
  // it is always populated, generated together with the Child row in
  // the same transaction, but the column stays nullable for
  // consent_type values that are family/account-scoped rather than
  // tied to one child (e.g. privacy_terms_update).
  childId               String?       @map("child_id") @db.Uuid
  // The actor-of-record — consent-architecture.md §3: "must resolve to
  // the Family's owning_parent_id for any owner-only consent type,
  // enforced by M2's authorization model, not redesigned here."
  consentingParentId    String        @map("consenting_parent_id") @db.Uuid
  consentType           ConsentType   @map("consent_type")
  action                ConsentAction
  // Free-text version identifier (semver or content hash per §3) — no
  // enumerated value set exists, same "not yet a closed set" reasoning
  // schema.prisma's own header comment already applies to
  // Device.deviceType/CoParentAssignment.permissionScope.
  privacyTermsVersion   String        @map("privacy_terms_version")
  // §3: "a bounded enum, values TBD from §8's shortlist... Left as a
  // placeholder... no value is populated until the founder/legal
  // process selects one." §8 only records a non-binding shortlist
  // *direction* (signed form primary, payment-card fallback) — no
  // value is founder-selected or legally validated yet, so this is
  // modeled as a plain nullable string, not a Prisma enum with
  // fabricated member values; every Track-A code path in this
  // milestone leaves it unset.
  verificationMethod    String?       @map("verification_method")
  // Opaque external pointer only — never a raw evidentiary artifact
  // (§6.3). No code path in this milestone populates this either.
  verificationReference String?       @map("verification_reference")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  ipAddressHash         String?       @map("ip_address_hash")

  family           Family @relation(fields: [familyId], references: [id])
  child            Child? @relation(fields: [childId], references: [id])
  consentingParent Parent @relation(fields: [consentingParentId], references: [id])

  @@index([familyId])
  @@index([childId])
  @@map("consent_event")
}

// M18 — Leo Foundation & Memory Isolation (docs/sprints/sprint-03.md,
// §4; ADR-0012; docs/architecture/ai-memory-isolation.md §3-§8). No
// AI/LLM integration, no embedding pipeline, no real conversation
// content — see leo/leo.service.ts's module header for the full scope
// note. Tier 3 — Sensitive Child Content (ADR-0006 §7-9): `content`
// columns below are envelope-encrypted application-side before the
// write reaches Postgres (leo/leo-encryption.service.ts), never
// encrypted/decrypted inside the database engine itself, per
// ai-memory-isolation.md §7.1.
enum MessageSender {
  child
  leo
}

// ai-memory-isolation.md §3.3 — discriminates the three independent,
// founder-already-approved memory classes (data-lifecycle.md §13.4).
enum LeoMemoryClass {
  active_relationship
  version_history
  permanent_vault
}

// Conversation.status / Message.status / LeoMemory.status — §3.1-§3.3:
// same active|deleted soft-delete flag as ChildStatus, reused as three
// separate enums (not ChildStatus itself) to keep each entity's status
// domain independently evolvable, matching this schema's existing
// one-enum-per-entity convention.
enum ConversationStatus {
  active
  deleted
}

enum MessageStatus {
  active
  deleted
}

enum LeoMemoryStatus {
  active
  deleted
}

// Per-Family Data Encryption Key envelope (data-classification-and-
// isolation.md §5.2: "each Family has exactly one active DEK... a
// design-level association only"). This table is that association,
// filled in for the first time by M18 since no Tier-3 entity existed
// before it. `wrappedDek` is the DEK ciphertext (random IV + GCM auth
// tag + ciphertext, concatenated — see leo-encryption.service.ts),
// wrapped by LEO_MEMORY_KEK — an explicit, dev-only stopgap standing
// in for the not-yet-selected production KMS (§5.3/§11 leave KMS
// product, key-rotation policy, and DEK-caching strategy undecided;
// see leo.config.ts's header for the full non-production disclaimer).
// No grant is issued to natkhat_app_role on this table at all (see
// this schema's migration, Part 2) — only this module's own
// admin-role Prisma client ever touches key material, keeping it
// structurally out of reach of the RLS-bounded request-serving role
// regardless of any application bug.
model FamilyEncryptionKey {
  id         String   @id @default(uuid()) @db.Uuid
  familyId   String   @unique @map("family_id") @db.Uuid
  wrappedDek Bytes    @map("wrapped_dek")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id])

  @@map("family_encryption_key")
}

// §3.1 / §4 — unlike ConsentEvent.childId (nullable, a consent event
// can precede its Child), a Conversation cannot exist before its Child
// does, so childId is NOT NULL here.
model Conversation {
  id            String             @id @default(uuid()) @db.Uuid
  familyId      String             @map("family_id") @db.Uuid
  childId       String             @map("child_id") @db.Uuid
  startedAt     DateTime           @default(now()) @map("started_at") @db.Timestamptz
  // Denormalized read-optimization field (§3.1) — Message rows remain
  // the source of truth for content/timing; this is updated
  // alongside each appended Message, not an independent fact.
  lastMessageAt DateTime           @default(now()) @map("last_message_at") @db.Timestamptz
  status        ConversationStatus @default(active)
  // Same soft-delete -> 90-day-hard-delete mechanism as Parent/Family/
  // Child (M16) — see those models' deletedAt/hardDeletedAt comments;
  // §5.2 reuses that already-approved window verbatim for this entity.
  deletedAt     DateTime?          @map("deleted_at") @db.Timestamptz
  hardDeletedAt DateTime?          @map("hard_deleted_at") @db.Timestamptz

  family   Family    @relation(fields: [familyId], references: [id])
  child    Child     @relation(fields: [childId], references: [id])
  messages Message[]

  @@index([familyId])
  @@index([childId])
  @@map("conversation")
}

// §3.2 — family_id/child_id are carried directly on Message
// (denormalized from Conversation), not derived only via a join: RLS
// must be able to partition this table on its own column (§3.2's
// stated rationale), and §7.4's cross-child application-layer check
// needs child_id directly on the row for the same reason.
model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  familyId       String        @map("family_id") @db.Uuid
  childId        String        @map("child_id") @db.Uuid
  sender         MessageSender
  // Tier 3, encrypted (see this section's header comment). Immutable
  // once written (§5.1) — no code path in this module ever updates
  // this column after INSERT, only status (soft-delete, §3.2) and, at
  // hard-delete, the scrub-on-tombstone step.
  content        Bytes
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  status         MessageStatus @default(active)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  hardDeletedAt  DateTime?     @map("hard_deleted_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id])
  family       Family       @relation(fields: [familyId], references: [id])
  child        Child        @relation(fields: [childId], references: [id])

  @@index([conversationId])
  @@index([familyId])
  @@index([childId])
  @@map("message")
}

// §3.3 — implements data-lifecycle.md §13.4's three already-approved
// memory classes; this table supplies the entity shape only, it does
// not redecide the classes, retention rules, or no-automatic-
// promotion business rule (see this schema section's header comment).
model LeoMemory {
  id                  String          @id @default(uuid()) @db.Uuid
  familyId            String          @map("family_id") @db.Uuid
  childId             String          @map("child_id") @db.Uuid
  memoryClass         LeoMemoryClass  @map("memory_class")
  // Tier 3, encrypted — distilled memory content, never a verbatim
  // Message copy (§3.4's minimization answer).
  content             Bytes
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  // §3.3/§5.1 — correction is always a NEW row; this points the new
  // Class-1 row at the prior row, whose own memoryClass is reassigned
  // to version_history in the same operation (leo.service.ts's
  // correctMemory) — never an in-place content mutation. onDelete:
  // SetNull so the (rare, config-driven) version-history expiry sweep
  // physically purging an old row never blocks on, or is blocked by,
  // a newer row's provenance pointer — provenance is informational,
  // not load-bearing for correctness once its target is gone.
  supersedesMemoryId  String?         @map("supersedes_memory_id") @db.Uuid
  // §3.3 — populated only when memoryClass = permanent_vault; points
  // at the Class 1/2 row a parent chose to preserve. A Vault row is
  // always a new row (never an existing row's memoryClass flipped to
  // permanent_vault in place), per §6.3/data-lifecycle.md §13.4's
  // no-automatic-promotion rule.
  vaultedFromMemoryId String?         @map("vaulted_from_memory_id") @db.Uuid
  // Populated only for permanent_vault rows. Founder decision
  // 2026-08-08 (§6.3): vaultedByParentId must resolve to the Family's
  // owning_parent_id — enforced in leo.service.ts's addToVault, not
  // merely documented here.
  vaultedAt           DateTime?       @map("vaulted_at") @db.Timestamptz
  vaultedByParentId   String?         @map("vaulted_by_parent_id") @db.Uuid
  status              LeoMemoryStatus @default(active)
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamptz
  hardDeletedAt       DateTime?       @map("hard_deleted_at") @db.Timestamptz

  family           Family      @relation(fields: [familyId], references: [id])
  child            Child       @relation(fields: [childId], references: [id])
  vaultedByParent  Parent?     @relation(fields: [vaultedByParentId], references: [id])
  supersedes       LeoMemory?  @relation("MemorySupersession", fields: [supersedesMemoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  supersededBy     LeoMemory[] @relation("MemorySupersession")
  vaultedFrom      LeoMemory?  @relation("MemoryVaultSource", fields: [vaultedFromMemoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  vaultedInstances LeoMemory[] @relation("MemoryVaultSource")

  @@index([familyId])
  @@index([childId])
  @@map("leo_memory")
}

// M25 (docs/sprints/sprint-05.md, §4; Founder Decision G.2) — the
// distinct admin-principal type the milestone's scope requires: kept
// separate from Parent/Child (ADR-0009's family principal types), not
// an extension of either. Mirrors Parent's own M15 auth_identity_ref
// link (auth/firebase-auth.service.ts) so admin-auth/admin-auth.service.ts
// can resolve a verified Firebase ID token to exactly one AdminUser the
// same way FirebaseAuthService already resolves one to a Parent — the
// two lookups never share a table, so a Parent's token cannot resolve
// an AdminUser and vice versa.
//
// No family_id, no Row-Level Security: apps/admin is not a
// tenant-scoped surface (Founder Decision F.3 bounds it to audit-log
// data only), and admin-auth/prisma-client.provider.ts's client — like
// audit/prisma-client.provider.ts's — is the same non-RLS admin/
// migration connection (DATABASE_URL), never the RLS-subject
// natkhat_app_role. No role/permission column: this milestone is
// authentication only, not an admin RBAC system (M25 explicit
// exclusion).
model AdminUser {
  id              String   @id @default(uuid()) @db.Uuid
  authIdentityRef String   @unique @map("auth_identity_ref")
  displayName     String   @map("display_name")
  contactEmail    String   @map("contact_email")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("admin_user")
}
