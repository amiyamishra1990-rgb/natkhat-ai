# Natkhat AI — backend environment template
#
# Local development only (docs/sprints/sprint-03.md, M13; Decision
# J.5). Placeholder value — never a real credential. No production
# database exists in Sprint 03.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/natkhat_dev"

# M14 (docs/sprints/sprint-03.md, §4; ADR-0010 §7.4): the non-superuser,
# non-BYPASSRLS request-serving role RLS is enforced against and proven
# against in tests. Created by the M14 migration
# (prisma/migrations/20260816090000_m14_identity_family_tenant_isolation).
# Same local-dev-only placeholder-credential convention as DATABASE_URL
# above — never a real credential, no production role exists in Sprint 03.
APP_DATABASE_URL="postgresql://natkhat_app_role:natkhat_app_role@localhost:5432/natkhat_dev"

# M15 (docs/sprints/sprint-03.md, §4; ADR-0005; Decision J.5): the
# real, non-production DEV Supabase project introduced specifically at
# this milestone — test accounts only, no India-residency claim, no
# production project or credential. Leave unset locally if you have
# not provisioned a dev project yet: auth/supabase-auth.service.ts and
# its integration test fail clearly (not silently) when these are
# missing, and unrelated backend commands (build, typecheck, lint,
# every other module's tests) do not require them — see
# auth/supabase-client.provider.ts.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# M16 (docs/sprints/sprint-03.md, §4; ADR-0015 §13.1/§13.2). Both
# founder-APPROVED (not provisional), but still read as configuration,
# not hardcoded — see lifecycle/lifecycle.config.ts. Safe to leave
# unset locally; both default to 90.
LIFECYCLE_SOFT_TO_HARD_DELETE_DAYS="90"
LIFECYCLE_BACKUP_PURGE_DAYS="90"

# M16 (docs/sprints/sprint-03.md, §4; ADR-0015 §13.3). APPROVED
# PROVISIONALLY only — subject to change pending India DPDP Act legal
# review (ADR-0006 §30). See audit/audit.config.ts. Safe to leave
# unset locally; defaults to 3.
AUDIT_TIER5_RETENTION_YEARS="3"

# M17 (docs/sprints/sprint-03.md, §4; §7 Risk Register). Must default
# to "false" — Track A's consent scaffold is legally-gated Sprint-03
# functionality and must never be enabled by default (see
# consent/consent.config.ts; no real feature-flag system exists yet in
# this repository — docs/engineering/feature-flags.md — this is a
# deliberate stopgap, not that future tool selection). Flip to "true"
# only for local testing of the scaffold itself.
CONSENT_TRACK_A_ENABLED="false"
