# Natkhat AI — backend environment template
#
# Local development only (docs/sprints/sprint-03.md, M13; Decision
# J.5; hosting amended by ADR-0016 — Google Cloud, Cloud SQL for
# PostgreSQL as the dev-instance candidate, engine/connection-string
# shape unchanged). Placeholder value — never a real credential. No
# production database exists in Sprint 03. When pointed at a Cloud SQL
# dev instance instead of a local Postgres, this remains a standard
# postgresql:// URL (via the Cloud SQL Auth Proxy or a private-IP
# connection) — no code change required.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/natkhat_dev"

# M14 (docs/sprints/sprint-03.md, §4; ADR-0010 §7.4): the non-superuser,
# non-BYPASSRLS request-serving role RLS is enforced against and proven
# against in tests. Created by the M14 migration
# (prisma/migrations/20260816090000_m14_identity_family_tenant_isolation).
# Same local-dev-only placeholder-credential convention as DATABASE_URL
# above — never a real credential, no production role exists in Sprint 03.
APP_DATABASE_URL="postgresql://natkhat_app_role:natkhat_app_role@localhost:5432/natkhat_dev"

# M15 (docs/sprints/sprint-03.md, §4; ADR-0016 — supersedes ADR-0005's
# authentication clause): the real, non-production DEV Firebase project
# (`natkhat-ai-dev`, Blaze plan) — test accounts only, no
# India-residency claim, no production project or credential. Leave
# unset locally if you have not been given access to the dev project
# yet: auth/firebase-auth.service.ts and its integration test fail
# clearly (not silently) when this is missing, and unrelated backend
# commands (build, typecheck, lint, every other module's tests) do not
# require it — see auth/firebase-admin.provider.ts.
#
# Credential strategy is Application Default Credentials, NOT a
# downloaded service-account key file (ADR-0016, Decision item 2 — the
# founder's GCP organization enforces
# `iam.managed.disableServiceAccountApiKeyCreation`). Run
# `gcloud auth application-default login` once locally; no
# GOOGLE_APPLICATION_CREDENTIALS env var is needed for that path (it is
# only read if you deliberately point it at a key file, which this
# project's dev workflow does not do).
FIREBASE_PROJECT_ID="natkhat-ai-dev"

# Used only by firebase-auth.integration.spec.ts's client-SDK sign-in
# step, to obtain a real, verifiable ID token to test against — never
# by application runtime code (which uses ADC only, via
# auth/firebase-admin.provider.ts). This is the project's public Web
# API key (Firebase Console → Project settings → General): not a
# secret by Firebase's own design (it ships in client bundles), but
# still left unset here rather than hardcoded, so this template never
# couples to one specific Firebase project. Leave unset locally to
# skip the integration suite.
FIREBASE_WEB_API_KEY=""

# M16 (docs/sprints/sprint-03.md, §4; ADR-0015 §13.1/§13.2). Both
# founder-APPROVED (not provisional), but still read as configuration,
# not hardcoded — see lifecycle/lifecycle.config.ts. Safe to leave
# unset locally; both default to 90.
LIFECYCLE_SOFT_TO_HARD_DELETE_DAYS="90"
LIFECYCLE_BACKUP_PURGE_DAYS="90"

# M16 (docs/sprints/sprint-03.md, §4; ADR-0015 §13.3). APPROVED
# PROVISIONALLY only — subject to change pending India DPDP Act legal
# review (ADR-0006 §30). See audit/audit.config.ts. Safe to leave
# unset locally; defaults to 3.
AUDIT_TIER5_RETENTION_YEARS="3"

# M17 (docs/sprints/sprint-03.md, §4; §7 Risk Register). Must default
# to "false" — Track A's consent scaffold is legally-gated Sprint-03
# functionality and must never be enabled by default (see
# consent/consent.config.ts; no real feature-flag system exists yet in
# this repository — docs/engineering/feature-flags.md — this is a
# deliberate stopgap, not that future tool selection). Flip to "true"
# only for local testing of the scaffold itself.
CONSENT_TRACK_A_ENABLED="false"

# M18 (docs/sprints/sprint-03.md, §4; ADR-0012;
# data-classification-and-isolation.md §5.2-§5.3/§11). NOT A PRODUCTION
# KEY-MANAGEMENT DECISION — see leo/leo.config.ts's header for the full
# disclaimer. This is a dev-only stopgap standing in for a not-yet-
# selected production KMS: a single base64-encoded 32-byte AES-256 key
# that wraps every Family's per-Family Data Encryption Key. Leave unset
# locally to exercise the fail-closed path (every Tier-3 read/write in
# leo/leo-encryption.service.ts throws rather than falling back to
# plaintext); set it (e.g. `openssl rand -base64 32`) only to exercise
# the Leo module's encrypted-content paths in local testing. Never a
# real credential, never committed with a real value, and never to be
# read as evidence that KMS product selection has happened.
LEO_MEMORY_KEK=""

# M18 (docs/sprints/sprint-03.md, §4; ai-memory-isolation.md §5.4).
# version_history LeoMemory rows age out independently of the current
# active row, on their own createdAt-based window — parent-
# configurable 30-365 days per §5.4. See leo/leo.config.ts. Safe to
# leave unset locally; defaults to 90.
LEO_VERSION_HISTORY_RETENTION_DAYS="90"

# M20 (docs/sprints/sprint-03.md, §4). Must default to "false" — the
# entire first end-to-end vertical slice (parent signup → family →
# child → Leo chat) is Track A demo/integration-test scope, not a
# feature, and must never run by default (same deliberate stopgap
# pattern as CONSENT_TRACK_A_ENABLED above; no real feature-flag system
# exists yet — docs/engineering/feature-flags.md). See
# test/vertical-slice.e2e-spec.ts. Flip to "true", plus
# CONSENT_TRACK_A_ENABLED="true" and a real LEO_MEMORY_KEK above, only
# to run that suite locally via `pnpm test:e2e`.
VERTICAL_SLICE_ENABLED="false"
