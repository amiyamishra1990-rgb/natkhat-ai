# Natkhat AI — backend environment template
#
# Local development only (docs/sprints/sprint-03.md, M13; Decision
# J.5). Placeholder value — never a real credential. No production
# database exists in Sprint 03.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/natkhat_dev"

# M14 (docs/sprints/sprint-03.md, §4; ADR-0010 §7.4): the non-superuser,
# non-BYPASSRLS request-serving role RLS is enforced against and proven
# against in tests. Created by the M14 migration
# (prisma/migrations/20260816090000_m14_identity_family_tenant_isolation).
# Same local-dev-only placeholder-credential convention as DATABASE_URL
# above — never a real credential, no production role exists in Sprint 03.
APP_DATABASE_URL="postgresql://natkhat_app_role:natkhat_app_role@localhost:5432/natkhat_dev"
