# Dependencies
node_modules/

# Turborepo
.turbo/

# Build output
dist/
build/
.next/
out/
coverage/

# Next.js auto-regenerates this on every `next dev`/`next build`
# (apps/admin, apps/website) — "should not be edited" per its own
# header comment.
next-env.d.ts

# TypeScript incremental-build cache (apps/admin, apps/website emit
# this at the app root since `incremental: true` is on but no explicit
# `tsBuildInfoFile` is set — apps/backend's own tsbuildinfo lands inside
# dist/, already covered by the "dist/" rule above).
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# apps/backend (NestJS) build output is covered by the "dist/" rule
# above; apps/admin and apps/website (Next.js, Sprint 04 M22) by the
# ".next/"/"out/" rules — no nested .gitignore needed for any of the
# three. apps/mobile (Flutter) has its own nested .gitignore
# (generated by `flutter create`), which git respects automatically —
# no Flutter-specific rules are duplicated here.
